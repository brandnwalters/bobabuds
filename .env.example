# Copy to .env.local for local development: cp .env.example .env.local
# The values below are the fixed defaults of the local Supabase CLI stack
# (see `pnpm exec supabase status`). On Vercel, set the hosted project's values.

# Supabase API URL and publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Supabase secret (service-role) key. Server-only: used by the seed command and
# the dev-only Dev Bar sign-in route. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Turns on the Dev Bar and its sign-in route. "true" locally and on Vercel
# preview deployments only; never set in production.
DEV_TOOLS=true

# Google Maps JavaScript API key for shop search (Places API (New)). It ships
# to the browser, so restrict it (see "Google Places key" in the README).
# Leave empty to search a built-in list of Chapel Hill/Durham shops instead
# (browser tests and local dev without a key; only when DEV_TOOLS=true).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only Google key for looking up shop details by place ID when a shop
# is first logged (Places API (New), no referrer restriction). Falls back to
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY. Never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_SERVER_KEY=
